# StellarDripz Environment Configuration
# Copy this file to .env.local and fill in the values

# ─── Node Environment ──────────────────────────────────────────────
NODE_ENV=development

# ─── Stellar Network ───────────────────────────────────────────────
# Set to 'mainnet' to use Mainnet, otherwise defaults to Testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# RPC & Horizon URLs (defaults to Testnet)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org
NEXT_PUBLIC_STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet

# ─── Deployed Contract IDs (fill after deploying) ──────────────────
NEXT_PUBLIC_CONTRACT_COUNTER=CDLZFC3SYJYDZT7K67VQ75BQHHPYXSOF3K5K5G3L6YP2MQUBQ7SJVMHV
NEXT_PUBLIC_CONTRACT_DRIP_TOKEN=CAOZK3JQVVXENUFHZ7ROZIZRYUWYXOPQ4WTG7Y6SLXQ36KI3ZXBGFQAP
NEXT_PUBLIC_CONTRACT_DRIP_POOL=CBQH2R4TJY7MP4ZXOQY5KHQSWCJJ5VB3LUM3PR4YKMDRIMTJMATJDGYT
NEXT_PUBLIC_CONTRACT_GOVERNANCE=CD2HKO7TPBJTKLRANQB5YRSJFG5LXBOU7SQY7LRXSGXMZEZSINHLTAD3
NEXT_PUBLIC_CONTRACT_BADGE=CBGYRAQMGEVBOMICBN7WIJQXEWCQ2JHW3BM2PI7B45Z7JKLCL5SXTIMJ

# ─── Rate Limiting (ms) ────────────────────────────────────────────
RATE_LIMIT_FAUCET_MS=60000
RATE_LIMIT_CONTRACT_MS=30000
RATE_LIMIT_GENERAL_MS=10000

# ─── Logging ───────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug

# ─── Deployer Secret Key (for deploy-contract.ts) ──────────────────
# ⚠️  NEVER commit this file with a real secret key!
DEPLOYER_SECRET_KEY=
