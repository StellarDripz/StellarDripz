{
  "name": "stellardripz",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": [
    "stellar",
    "soroban",
    "faucet",
    "smart-contracts",
    "nextjs",
    "blockchain",
    "web3",
    "testnet"
  ],
  "repository": "https://github.com/StellarDripz/StellarDripz",
  "private": true,
  "description": "StellarDripz — Production-grade Stellar dApp with advanced Soroban smart contracts (DripToken, DripPool, DripGovernance, DripBadge), multi-wallet faucet, real-time event streaming, and CI/CD pipeline.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --passWithNoTests --verbose",
    "verify": "npm run typecheck && npm test",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "contracts:build": "cd contracts && cargo build --target wasm32-unknown-unknown --release",
    "contracts:test": "cd contracts && cargo test --verbose",
    "contracts:deploy": "npx ts-node --transpile-only scripts/deploy-contract.ts",
    "clean": "rm -rf .next contracts/target"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@stellar/freighter-api": "^3.0.0",
    "@stellar/stellar-sdk": "^12.3.0",
    "next": "^14.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2"
  }
}
